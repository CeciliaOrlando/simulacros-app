NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo (mails transaccionales)
BREVO_API_KEY=
# Email verificado en Brevo. Acepta "Nombre <email@dominio.com>" o solo el email.
EMAIL_REMITENTE=

# Protege la ruta /api/cron (generar con: openssl rand -hex 32)
CRON_SECRET=

# URL pública de la app (ej: https://simulacros.vercel.app). Se usa para mostrar el logo en los mails.
# En local dejarla vacía: los mails muestran un sello "LGV" en lugar del logo.
URL_PUBLICA_APP=

# SMS Gateway for Android (SMSGate) en modo Cloud. Usuario y contraseña: los muestra la app en "Cloud server".
# URL: https://api.sms-gate.app/3rdparty/v1
SMSGATE_URL=
SMSGATE_USER=
SMSGATE_PASSWORD=
